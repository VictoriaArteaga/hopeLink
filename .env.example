# Application
NODE_ENV=development
PORT=3000
APP_NAME=HopeLink

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hopelink_user
DB_PASSWORD=your_secure_password
DB_DATABASE=hopelink_db
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# External APIs (if needed)
MAPS_API_KEY=
WEATHER_API_KEY=

# Email Notifications (optional)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
